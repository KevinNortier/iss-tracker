<?xml version="1.0" encoding="utf-8"?>
<!--
  ISS silhouette: a horizontal truss with two pairs of solar arrays on each end,
  modules in the middle, and an orbit arc. Everything stays inside the 66dp safe zone (21..87).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- scaled to leave some space inside the round icon mask -->
    <group android:scaleX="0.85" android:scaleY="0.85" android:pivotX="54" android:pivotY="54">
        <!-- orbit arc behind the station -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFB74D"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:pathData="M25,66 C40,80 72,74 84,46" />
        <!-- solar arrays (left pair) -->
        <path
            android:fillColor="#5B8FE0"
            android:pathData="M31,36h6v15h-6z M39,36h6v15h-6z M31,57h6v15h-6z M39,57h6v15h-6z" />
        <!-- solar arrays (right pair) -->
        <path
            android:fillColor="#5B8FE0"
            android:pathData="M63,36h6v15h-6z M71,36h6v15h-6z M63,57h6v15h-6z M71,57h6v15h-6z" />
        <!-- truss -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M29,52.5h50v3h-50z" />
        <!-- pressurised modules -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M51,43h6v22h-6z M47,59h14v4h-14z" />
    </group>
</vector>
